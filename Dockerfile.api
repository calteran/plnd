# Rust API Dockerfile
FROM rust:latest AS builder

WORKDIR /app
COPY Cargo.toml .
COPY plnd_api plnd_api
COPY plnd_data plnd_data
COPY config/api /app/config/api

RUN apt-get update && apt-get install -y pkg-config libssl-dev && \
    cargo build --release --package plnd_api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y libssl3 wget && rm -rf /var/lib/apt/lists/*

WORKDIR /app/bin
COPY --from=builder /app/target/release/plnd_api .
COPY --from=builder /app/config /app/config

EXPOSE 3000
CMD ["./plnd_api"]