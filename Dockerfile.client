# Angular Client Dockerfile
FROM node:20 as builder

WORKDIR /app
COPY plnd_client .

RUN npm install && \
    npm install -g @angular/cli@21

FROM nginx:alpine

# For development, we'll serve the source files directly
# In production, you would build and copy the dist files
COPY plnd_client/src /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 4200
CMD ["nginx", "-g", "daemon off;"]