# PLND Configuration — Doppler-managed secrets
#
# Secrets are managed via Doppler (project: plnd, config: dev).
# Run any command that needs secrets with:
#
#   doppler run -- <command>
#
# Examples:
#   doppler run -- cargo run          (same as `just api`)
#   doppler run -- docker compose up  (same as `just dev`)
#
# Doppler injects the following secrets as environment variables:
#   APP_AUTH__JWT_SECRET          — JWT signing secret
#   APP_DATABASE__URL             — PostgreSQL connection URL (local/non-Docker)
#   DB_PASSWORD                   — Postgres container password (Docker Compose)
#   APP_EXTERNAL__USDA_FDC_API_KEY — USDA FDC API key (get one free at fdc.nal.usda.gov)
#   APP_EXTERNAL__THEMEALDB_API_KEY — TheMealDB API key (default: "1" for free tier)
#
# The following non-sensitive vars can be overridden locally without Doppler:

# API Configuration
APP_API__BASE_URL=0.0.0.0:3000
APP_API__TIMEOUT=30000

# Logging Configuration
APP_LOGGING__LEVEL=info
APP_LOGGING__PRETTY_PRINT=true

# Database pool (optional overrides)
APP_DATABASE__MAX_CONNECTIONS=10

# Agent rate limit (requests per minute per authenticated user; default 10)
APP_AGENT__RATE_LIMIT_PER_MINUTE=10

# Meal plan concurrency (max parallel slot fills; default 4)
APP_AGENT__MEAL_PLAN_CONCURRENCY=4
