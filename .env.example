# PLND Configuration Environment Variables
# 
# This file shows the environment variables that can be used to override
# the TOML configuration files. All variables should be prefixed with APP_
# and use double underscores (__) for nested configuration.

# API Configuration
APP_API__BASE_URL=0.0.0.0:3000
APP_API__TIMEOUT=30000

# Database Configuration
APP_DATABASE__URL=postgres://plnd:plnd_dev@localhost/plnd_dev
APP_DATABASE__MAX_CONNECTIONS=10

# Logging Configuration
APP_LOGGING__LEVEL=info
APP_LOGGING__PRETTY_PRINT=true

# Environment-specific examples:
# For development:
# APP_LOGGING__LEVEL=debug
# APP_API__TIMEOUT=60000

# For production:
# APP_LOGGING__LEVEL=info
# APP_LOGGING__PRETTY_PRINT=false
# APP_API__TIMEOUT=10000