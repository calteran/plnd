{
  "name": "plnd-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check-dependencies": "ncu --peer",
    "check-licenses": "license-checker-rseidelsohn --summary",
    "check-circular": "depcruise src",
    "check-color-tokens": "node scripts/check-color-tokens.mjs",
    "e2e": "playwright test",
    "e2e:ci": "CI=true playwright test --project=chromium",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "undici": "^7.24.4",
    "picomatch": "^4.0.4",
    "@ngrx/store": {
      "@angular/core": "$@angular/core"
    },
    "@ngrx/effects": {
      "@angular/core": "$@angular/core"
    },
    "@ngrx/entity": {
      "@angular/core": "$@angular/core"
    },
    "@ngrx/store-devtools": {
      "@angular/core": "$@angular/core"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.0.3",
    "@angular/common": "~22.0.5",
    "@angular/compiler": "~22.0.5",
    "@angular/core": "~22.0.5",
    "@angular/forms": "~22.0.5",
    "@angular/platform-browser": "~22.0.5",
    "@angular/router": "~22.0.5",
    "@ngrx/effects": "~21.1.1",
    "@ngrx/entity": "~21.1.1",
    "@ngrx/store": "~21.1.1",
    "@ngrx/store-devtools": "~21.1.1",
    "angular-oauth2-oidc": "^22.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "~22.0.0",
    "@angular/build": "~22.0.5",
    "@angular/cli": "~22.0.5",
    "@angular/compiler-cli": "~22.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-istanbul": "^4.0.8",
    "angular-eslint": "~22.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "npm-check-updates": "^22.2.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^5.0.3"
  }
}
