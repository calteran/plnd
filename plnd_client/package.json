{
  "name": "plnd-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check-dependencies": "ncu --peer",
    "check-licenses": "license-checker-rseidelsohn --summary",
    "check-circular": "depcruise src",
    "e2e": "playwright test",
    "e2e:ci": "CI=true playwright test --project=chromium",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "undici": "^7.24.4",
    "picomatch": "^4.0.4"
  },
  "dependencies": {
    "@angular/common": "~21.2.13",
    "@angular/compiler": "~21.2.13",
    "@angular/core": "~21.2.13",
    "@angular/forms": "~21.2.13",
    "@angular/platform-browser": "~21.2.13",
    "@angular/router": "~21.2.13",
    "@ngrx/effects": "~21.1.0",
    "@ngrx/entity": "~21.1.0",
    "@ngrx/store": "~21.1.0",
    "@ngrx/store-devtools": "~21.1.0",
    "angular-oauth2-oidc": "^20.0.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "~21.4.0",
    "@angular-eslint/eslint-plugin": "~21.4.0",
    "@angular-eslint/eslint-plugin-template": "~21.4.0",
    "@angular-eslint/template-parser": "~21.4.0",
    "@angular/build": "~21.2.11",
    "@angular/cli": "~21.2.11",
    "@angular/compiler-cli": "~21.2.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/jasmine": "~6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.58.1",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "npm-check-updates": "^22.2.0",
    "typescript": "^5.9.3"
  }
}
