// ── Receive OTLP from native API (traces + metrics + logs) ──────────────────
otelcol.receiver.otlp "api" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// ── Batch to reduce network chatter ─────────────────────────────────────────
otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// ── Traces → Tempo ───────────────────────────────────────────────────────────
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// ── Metrics → Prometheus via remote_write ───────────────────────────────────
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint { url = "http://prometheus:9090/api/v1/write" }
}

// ── Logs (OTLP from API) → Loki ─────────────────────────────────────────────
otelcol.exporter.loki "default" {
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

// ── Docker container logs (postgres, mock-oauth) → Loki ─────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.local.receiver]
}

// ── LM Studio server logs → Loki ────────────────────────────────────────────
local.file_match "lmstudio" {
  path_targets = [{
    "__path__"     = "/var/log/lmstudio/**/*.log",
    "service_name" = "lmstudio",
  }]
}

loki.source.file "lmstudio" {
  targets    = local.file_match.lmstudio.targets
  forward_to = [loki.process.lmstudio.receiver]
}

loki.process "lmstudio" {
  // Merge multiline entries (JSON response dumps etc.) into a single Loki record.
  // A new logical entry starts when a line begins with '[' (the LMStudio timestamp bracket).
  // Continuation lines (JSON fragments, blank lines) are appended to the previous entry.
  stage.multiline {
    firstline     = `^\[`
    max_wait_time = "3s"
  }

  // Parse: [2026-04-10 13:03:32][INFO][google/gemma-4-26b-a4b] message
  // Note: we intentionally do not use stage.timestamp here. LMStudio logs are
  // in local time; Docker containers run UTC, so parsing the timestamp would
  // make entries appear future-dated and cause Loki to reject them. Loki uses
  // ingestion time instead, which is correct for real-time dev session monitoring.
  stage.regex {
    expression = `^\[(?P<ts>[^\]]+)\]\[(?P<level>[^\]]+)\](?:\[(?P<component>[^\]]+)\])? (?P<message>.*)`
  }
  // Index level + component as Loki labels for fast filtering
  stage.labels {
    values = {
      level     = "level",
      component = "component",
    }
  }
  forward_to = [loki.write.local.receiver]
}
