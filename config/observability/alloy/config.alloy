// ── Receive OTLP from native API (traces + metrics + logs) ──────────────────
otelcol.receiver.otlp "api" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// ── Batch to reduce network chatter ─────────────────────────────────────────
otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.processor.transform.loki_labels.input]
  }
}

// Promote selected resource attributes to Loki labels (otherwise they land as
// structured metadata). `verify.run_id` lets us filter a single verify run in
// Grafana: {service_name="plnd_api", verify_run_id="<id>"}.
otelcol.processor.transform "loki_labels" {
  error_mode = "ignore"
  log_statements {
    context = "resource"
    statements = [
      `set(attributes["loki.resource.labels"], "service.name, verify.run_id")`,
    ]
  }
  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

// ── Traces → Tempo ───────────────────────────────────────────────────────────
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// ── Metrics → Prometheus via remote_write ───────────────────────────────────
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint { url = "http://prometheus:9090/api/v1/write" }
}

// ── Logs (OTLP from API) → Loki ─────────────────────────────────────────────
otelcol.exporter.loki "default" {
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

// ── Docker container logs (postgres, mock-oauth) → Loki ─────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.local.receiver]
}

