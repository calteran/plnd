{
  "id": null,
  "uid": "plnd-prvdrs",
  "title": "PLND External Providers",
  "tags": ["plnd"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Provider Call Duration p95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(tempo_spanmetrics_duration_seconds_bucket{span_name=~\"provider::.*\"}[5m])) by (le, span_name))",
          "legendFormat": "p95 {{span_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provider Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(tempo_spanmetrics_calls_total{span_name=~\"provider::.*\", status_code=\"STATUS_CODE_ERROR\"}[5m])) by (span_name)\n/ sum(rate(tempo_spanmetrics_calls_total{span_name=~\"provider::.*\"}[5m])) by (span_name)",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provider Call Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(tempo_spanmetrics_calls_total{span_name=~\"provider::.*\"}[1m])) by (span_name)",
          "legendFormat": "{{span_name}}"
        }
      ]
    }
  ]
}
