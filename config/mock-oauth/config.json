{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "plnd-dev",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "^client_credentials$",
          "claims": {
            "sub": "${client_id}",
            "aud": ["mock-client"]
          }
        }
      ]
    }
  ]
}
